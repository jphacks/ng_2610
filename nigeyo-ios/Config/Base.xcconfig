// Shared settings for every target. Per-developer signing lives in Local.xcconfig (not in Git).
BASE_BUNDLE_ID = jp.nigeyo.hackathon
BUNDLE_ID_SUFFIX =
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "../Local.xcconfig"

// iOS only: keep Xcode from offering "My Mac (Designed for iPad)", which breaks UIKit indexing.
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
