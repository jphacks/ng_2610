// Shared settings for every target. Per-developer signing lives in Local.xcconfig (not in Git).
BASE_BUNDLE_ID = jp.nigeyo.hackathon
BUNDLE_ID_SUFFIX =
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Opt in only on a paid team whose App ID supports Push Notifications.
// Keep the entitlement on the iOS app target, not the widget or test bundle.
NIGEYO_LIVE_REGISTRATION_HOST =
NIGEYO_APNS_ENTITLEMENTS =
NIGEYO_ENTITLEMENTS_Nigeyo = $(NIGEYO_APNS_ENTITLEMENTS)
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = $(NIGEYO_ENTITLEMENTS_$(TARGET_NAME))

#include? "../Local.xcconfig"

// iOS only: keep Xcode from offering "My Mac (Designed for iPad)", which breaks UIKit indexing.
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
