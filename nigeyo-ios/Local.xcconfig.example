// Copy to nigeyo-ios/Local.xcconfig (git-ignored) and fill in.
// The presentation build uses BUNDLE_ID_SUFFIX = (empty) → jp.nigeyo.hackathon.
// Fix the bundle ID before configuring the shortcuts; changing it means redoing notification automations.
DEVELOPMENT_TEAM = ABCDE12345
BUNDLE_ID_SUFFIX = .yourname

// Uncomment for an APNs build signed by the paid team. Match the App Store Connect bundle ID.
// NIGEYO_APNS_ENTITLEMENTS = Config/Nigeyo.entitlements

// Hostname of the LiveRegistrationUrl stack output (omit scheme and path).
// NIGEYO_LIVE_REGISTRATION_HOST = example.execute-api.ap-northeast-1.amazonaws.com
